          <datasource-dependencies datasource='federated.1n8pion1csyyoa19p8mwg0eu0cyd'>
            <column caption='Member Share' datatype='real' name='[Calculation_1073971484172292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([member_casual]=&apos;member&apos;,1,0)) / COUNT([ride_id])' />
