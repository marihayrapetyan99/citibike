    <worksheet name='Daily Rides and Temperature'>
      <table>
        <view>
          <datasources>
            <datasource caption='citibike' name='federated.1n8pion1csyyoa19p8mwg0eu0cyd' />
          </datasources>
          <datasource-dependencies datasource='federated.1n8pion1csyyoa19p8mwg0eu0cyd'>
            <column caption='Total Rides' datatype='integer' name='[Calculation_1073971475251200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([ride_id])' />
            </column>
            <column caption='Average Ride Duration' datatype='real' name='[Calculation_1073971483271169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([ride_duration_minutes])' />
            </column>
            <column caption='Average Distance' datatype='real' name='[Calculation_1073971483410434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([distance_km])' />
            </column>
            <column caption='Member Ride Flag' datatype='integer' name='[Calculation_1073971483504643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [member_casual] = &apos;member&apos; THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Member Share' datatype='real' name='[Calculation_1073971484172292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([member_casual]=&apos;member&apos;,1,0)) / COUNT([ride_id])' />
            </column>
            <column caption='Rainy Ride Flag' datatype='integer' name='[Calculation_1073971484418053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [precipitation_flag] = &apos;Precipitation&apos; THEN 1 &#13;&#10;ELSE 0 &#13;&#10;END' />
            </column>
            <column caption='Rainy Ride Share' datatype='real' name='[Calculation_1073971484827654]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1073971484418053]) / COUNT([ride_id])' />
            </column>
            <column caption='Rainy Day Rides' datatype='integer' name='[Calculation_1073971487842313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [precipitation_flag] = &apos;Precipitation&apos; THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
